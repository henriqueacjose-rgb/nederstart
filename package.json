{
  "name": "nederstart",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm --filter @nederstart/web dev",
    "build": "pnpm --filter @nederstart/web build",
    "lint": "pnpm --filter @nederstart/web lint",
    "typecheck": "pnpm --filter @nederstart/web typecheck",
    "validate:remote": "node scripts/deploy/validate-remote.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
