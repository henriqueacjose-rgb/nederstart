generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── NextAuth ───────────────────────────────────────────────────────

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  emailVerified       DateTime?
  hashedPassword      String?
  displayName         String?
  avatarUrl           String?
  role                String    @default("learner")
  uiLocale            String    @default("en")
  timezone            String    @default("Europe/Amsterdam")
  onboardingCompleted Boolean   @default(false)
  learningGoal        String?
  studyFrequency      Int?
  startingLevel       String    @default("A0")
  plan                String    @default("free")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  lessonProgress     LessonProgress[]
  vocabularyProgress VocabularyProgress[]
  streak             UserStreak?
  xpEvents           UserXpEvent[]
  achievements       UserAchievement[]
  subscription       Subscription?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Course Structure ───────────────────────────────────────────────

model Level {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  sortOrder   Int
  isPublished Boolean  @default(false)
  xpRequired  Int      @default(0)
  createdAt   DateTime @default(now())

  translations LevelTranslation[]
  modules      Module[]
}

model LevelTranslation {
  id          Int    @id @default(autoincrement())
  levelId     Int
  locale      String
  title       String
  description String?

  level Level @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([levelId, locale])
}

model Module {
  id          Int      @id @default(autoincrement())
  levelId     Int
  sortOrder   Int
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())

  level        Level               @relation(fields: [levelId], references: [id], onDelete: Cascade)
  translations ModuleTranslation[]
  lessons      Lesson[]

  @@index([levelId])
}

model ModuleTranslation {
  id          Int    @id @default(autoincrement())
  moduleId    Int
  locale      String
  title       String
  description String?

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, locale])
}

model Lesson {
  id                   Int      @id @default(autoincrement())
  moduleId             Int
  lessonCode           String   @unique
  sortOrder            Int
  isPublished          Boolean  @default(false)
  isFree               Boolean  @default(false)
  estimatedMinutes     Int      @default(10)
  xpReward             Int      @default(50)
  prerequisiteLessonId Int?
  createdAt            DateTime @default(now())

  module             Module              @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  prerequisiteLesson Lesson?             @relation("LessonPrerequisite", fields: [prerequisiteLessonId], references: [id])
  dependentLessons   Lesson[]            @relation("LessonPrerequisite")
  translations       LessonTranslation[]
  sections           LessonSection[]
  lessonVocabulary   LessonVocabulary[]
  audioAssets        AudioAsset[]
  progress           LessonProgress[]

  @@index([moduleId])
}

model LessonTranslation {
  id                 Int      @id @default(autoincrement())
  lessonId           Int
  locale             String
  title              String
  description        String?
  learningObjectives String[]

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, locale])
}

model LessonSection {
  id          Int      @id @default(autoincrement())
  lessonId    Int
  sortOrder   Int
  sectionType String
  content     Json     @default("{}")
  createdAt   DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

// ─── Vocabulary ─────────────────────────────────────────────────────

model Vocabulary {
  id         Int      @id @default(autoincrement())
  dutchWord  String
  wordType   String?
  gender     String?
  difficulty Int      @default(1)
  createdAt  DateTime @default(now())

  translations VocabularyTranslation[]
  lessons      LessonVocabulary[]
  audioAssets  AudioAsset[]
  progress     VocabularyProgress[]
}

model VocabularyTranslation {
  id                Int    @id @default(autoincrement())
  vocabularyId      Int
  locale            String
  translation       String
  pronunciationHint String?
  exampleSentence   String?

  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@unique([vocabularyId, locale])
}

model LessonVocabulary {
  lessonId     Int
  vocabularyId Int

  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@id([lessonId, vocabularyId])
}

model AudioAsset {
  id           Int      @id @default(autoincrement())
  storagePath  String
  assetType    String
  vocabularyId Int?
  lessonId     Int?
  speakerCode  String?
  durationMs   Int?
  createdAt    DateTime @default(now())

  vocabulary Vocabulary? @relation(fields: [vocabularyId], references: [id])
  lesson     Lesson?     @relation(fields: [lessonId], references: [id])

  @@index([vocabularyId])
  @@index([lessonId])
}

// ─── Exercises ──────────────────────────────────────────────────────

model Exercise {
  id           Int      @id @default(autoincrement())
  exerciseType String
  difficulty   Int      @default(1)
  createdAt    DateTime @default(now())

  translations ExerciseTranslation[]
  options      ExerciseOption[]
}

model ExerciseTranslation {
  id          Int    @id @default(autoincrement())
  exerciseId  Int
  locale      String
  question    String
  instruction String?
  explanation String?

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, locale])
}

model ExerciseOption {
  id         Int     @id @default(autoincrement())
  exerciseId Int
  sortOrder  Int
  optionText String
  isCorrect  Boolean @default(false)
  feedback   String?

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([exerciseId])
}

// ─── Progress ───────────────────────────────────────────────────────

model LessonProgress {
  id           Int       @id @default(autoincrement())
  userId       String
  lessonId     Int
  status       String    @default("not_started")
  score        Int?
  timeSpentS   Int?
  completedAt  DateTime?
  startedAt    DateTime?
  attemptCount Int       @default(0)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

model VocabularyProgress {
  id             Int      @id @default(autoincrement())
  userId         String
  vocabularyId   Int
  status         String   @default("new")
  correctCount   Int      @default(0)
  incorrectCount Int      @default(0)
  lastReviewed   DateTime?
  nextReview     DateTime?
  easeFactor     Float    @default(2.5)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@unique([userId, vocabularyId])
  @@index([userId])
  @@index([userId, nextReview])
}

// ─── Gamification ───────────────────────────────────────────────────

model UserStreak {
  userId                String    @id
  currentStreak         Int       @default(0)
  longestStreak         Int       @default(0)
  lastActivityDate      DateTime? @db.Date
  streakFreezeAvailable Int       @default(0)
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserXpEvent {
  id          Int      @id @default(autoincrement())
  userId      String
  xpAmount    Int
  reason      String
  referenceId String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Achievement {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  icon      String?
  xpBonus   Int      @default(0)
  createdAt DateTime @default(now())

  translations AchievementTranslation[]
  users        UserAchievement[]
}

model AchievementTranslation {
  id            Int    @id @default(autoincrement())
  achievementId Int
  locale        String
  title         String
  description   String?

  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([achievementId, locale])
}

model UserAchievement {
  userId        String
  achievementId Int
  earnedAt      DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
}

// ─── Subscriptions ──────────────────────────────────────────────────

model Plan {
  id                   Int      @id @default(autoincrement())
  code                 String   @unique
  stripePriceIdMonthly String?
  stripePriceIdYearly  String?
  priceMonthlyEur      Decimal? @db.Decimal(10, 2)
  priceYearlyEur       Decimal? @db.Decimal(10, 2)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())

  subscriptions Subscription[]
}

model Subscription {
  id                   Int      @id @default(autoincrement())
  userId               String   @unique
  planId               Int
  stripeSubscriptionId String?
  stripeCustomerId     String?
  status               String   @default("active")
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAt             DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([stripeSubscriptionId])
}