{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@nederstart/content": ["../../packages/content/src/index.ts"],
      "@nederstart/core": ["../../packages/core/src/index.ts"],
      "@nederstart/shared": ["../../packages/shared/src/index.ts"],
      "@nederstart/core/*": ["../../packages/core/src/*"],
      "@nederstart/shared/*": ["../../packages/shared/src/*"],
      "@nederstart/content/*": ["../../packages/content/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
